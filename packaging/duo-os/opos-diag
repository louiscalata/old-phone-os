#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# One diagnostics dump per boot, 90 s after boot, for reading after a failed or dark boot:
# /var/log/opos-boot-diag.txt (the journal itself is persistent too).
out=/var/log/opos-boot-diag.txt
sleep 90
{
    echo "== $(date -Is)  up $(cut -d' ' -f1 /proc/uptime)s  kernel $(uname -r)  opos $(cat /opt/opos/REVISION 2>/dev/null)"
    echo "== system state: $(systemctl is-system-running)"
    echo "== failed units"; systemctl --failed --no-legend
    echo "== unit states (lxc@android, composer, opos-server, opos, phosh, item)"
    systemctl is-active lxc@android android-service@hwcomposer opos-server opos phosh item
    echo "== sessions"; loginctl list-sessions --no-legend
    echo "== processes"; ps -eo pid,user,comm,args | grep -E 'phoc|chromium|composer|opos|python3 -m' | grep -v grep | cut -c1-240
    echo "== /dev/dri, /dev/input"; ls -l /dev/dri /dev/input 2>&1 | head -30
    echo "== network"; ip -br addr 2>&1
    # --- track: network (read-only): what each radio reports, and what OPOS's user (droidian) may change ---
    # No SSIDs, addresses or IMEI: connection names are left out, only the state words and the permission names are kept.
    echo "== radios"
    echo "radios: rfkill: $(timeout 5 rfkill list 2>&1 | tr '\n\t' '  ' | tr -s ' ')"
    echo "radios: NetworkManager: $(timeout 5 nmcli -t -f RUNNING,STATE,CONNECTIVITY,WIFI-HW,WIFI,WWAN-HW,WWAN general status 2>&1 | head -1)"
    echo "radios: devices: $(timeout 5 nmcli -t -f DEVICE,TYPE,STATE device status 2>&1 | tr '\n' ' ')"
    echo "radios: modem: $(timeout 8 mmcli -K -m any 2>&1 | grep -E 'generic\.(state|power-state|sim|state-failed-reason|unlock-required)|access-technologies\.value|3gpp\.(registration-state|operator-name)|signal-quality\.value|couldn.t' | tr -s ' ' | tr '\n' ';')"
    echo "radios: bluetooth: $(timeout 5 bluetoothctl show 2>&1 | grep -E 'Powered|No default' | tr -d '\t' | tr '\n' ' ')"
    echo "radios: droidian may: $(timeout 5 runuser -u droidian -- nmcli -t general permissions 2>&1 | grep -E 'enable-disable-wifi|network-control|settings.modify.system|wifi.scan|rror' | sed 's/org.freedesktop.NetworkManager.//' | tr '\n' ' ')"
    # --- end track: network ---
    # --- track: radio watch ---
    radio_watch() {
        echo "== radio watch"
        wlan=unavailable
        if [ -d "$1/class/net" ]; then
            wlan=missing
            [ ! -d "$1/class/net/wlan0" ] || wlan=present
        fi
        echo "watch: wlan0 $wlan"

        modem=unavailable
        if busctl --system --auto-start=no --allow-interactive-authorization=no --timeout=5s --quiet \
            call org.ofono /ril_0 org.ofono.Modem GetProperties >/dev/null 2>&1; then
            modem=present
        fi
        echo "watch: ril_0 $modem"

        adsp=
        for processor in "$1"/class/remoteproc/remoteproc*; do
            compatible="$processor/device/of_node/compatible"
            if [ -r "$compatible" ] &&
                tr '\000' '\n' 2>/dev/null <"$compatible" | grep -Fqx 'qcom,sm8150-adsp-pas' 2>/dev/null; then
                if [ -n "$adsp" ]; then
                    adsp=
                    break
                fi
                adsp="$processor"
            fi
        done
        state=unavailable
        if [ -n "$adsp" ] && [ -r "$adsp/state" ] && { IFS= read -r reported <"$adsp/state"; } 2>/dev/null; then
            case "$reported" in
                running) state=running ;;
                offline|suspended|crashed) state='not running' ;;
            esac
        fi
        echo "watch: adsp $state"
    }
    radio_watch /sys
    # --- end track: radio watch ---
    echo "== power supplies"
    for d in /sys/class/power_supply/*; do echo "$d: $(cat "$d/type" 2>/dev/null) $(cat "$d/capacity" 2>/dev/null) $(cat "$d/status" 2>/dev/null)"; done
    echo "== OPOS units, this boot"
    journalctl -b -u opos.service -u opos-server.service -u opos-fallback.service --no-pager 2>&1 | tail -150
    echo "== DRM clients (the composer must show master y)"; cat /sys/kernel/debug/dri/0/clients 2>&1
    echo "== panel backlights"
    for b in /sys/class/backlight/*; do
        echo "$b brightness=$(cat "$b/brightness" 2>/dev/null) actual=$(cat "$b/actual_brightness" 2>/dev/null) max=$(cat "$b/max_brightness" 2>/dev/null) bl_power=$(cat "$b/bl_power" 2>/dev/null)"
    done
    # --- track: device facts (read-only): the declared Duo profile (src/opos/hw/device.py) against what the kernel reports ---
    echo "== device facts"
    PYTHONPATH=/opt/opos/src timeout 20 python3 -B -m opos.hw.facts --root / --profile "Surface Duo" 2>&1; echo "facts: exit $?"
    # --- end track: device facts ---
    echo "== phoc, this boot"; journalctl -b -t phoc --no-pager 2>&1 | tail -40
    echo "== kernel warnings and errors"; dmesg --level=err,warn 2>/dev/null | tail -80
} > "$out" 2>&1
