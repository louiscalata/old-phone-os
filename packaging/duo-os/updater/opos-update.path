# SPDX-License-Identifier: GPL-3.0-or-later
# Starts opos-update.service when a finished bundle or a rollback request is in the inbox.
#
# PathExistsGlob/PathExists, not PathChanged and not DirectoryNotEmpty:
# - The client delivers a bundle by renaming "<name>.partial" to "<name>.opos-update", so the glob matches
#   only a complete bundle. DirectoryNotEmpty would fire for every half-downloaded ".partial" file and loop.
# - PathChanged forgets events that happen while the service runs. PathExistsGlob is checked again when the
#   service ends, so a bundle that arrives during a run starts the next one (and the updater also rescans
#   the inbox before it exits). The updater removes every bundle it looked at, accepted or not, which is
#   what ends the loop. The service has no start limit (the inbox's writer is not root, so a limit would be a switch
#   for it), and the updater lingers a moment after each run, which is what paces a flood of files.
[Unit]
Description=OPOS update inbox

[Path]
PathExistsGlob=/var/lib/opos-update/inbox/*.opos-update
PathExists=/var/lib/opos-update/inbox/rollback.request
Unit=opos-update.service
MakeDirectory=no

[Install]
WantedBy=multi-user.target
