[Unit]
Description=OPOS server: rules, governor and helper on the phone's real battery
After=network.target lxc@android.service
Wants=lxc@android.service

[Service]
User=droidian
Environment=PYTHONPATH=/opt/opos/src
# On-screen keyboard (src/opos/osk.py): 1 serves the in-page keyboard to the kiosk page. /etc/default/opos-osk overrides it:
# OPOS_OSK=off for none, OPOS_OSK=stevia for the port's Wayland keyboard instead (opos-osk.service), see packaging/duo-os/OSK.md.
Environment=OPOS_OSK=1
EnvironmentFile=-/etc/default/opos-osk
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPOS_BATTERY=live
Environment=OPOS_ON_PHONE=1
# Two-screen span, off until the layout is checked on the phone. The kiosk window covers both panels and the
# hinge, and Chromium on Linux cannot report where the hinge is, so the server has to say. The value is
# PANE,HINGE in CSS px. The Duo's 2784x1800 output is two 1350 px panels and an 84 px hinge (the port's
# display-panel file) and phoc.ini sets output scale 2, so 675,42, for a window 1392 px wide (not yet
# measured on the phone). To try it: remove the leading # below, run sudo systemctl daemon-reload and
# sudo systemctl restart opos-server, then pkill chromium as the droidian user (opos-kiosk starts it again).
#Environment=OPOS_SPAN=675,42
# >>> track panes: black and white pane surfaces and the Hand setting (src/opos/panes.py, docs/jaryo-panes.md). They paint only on a window
# that spans both panels, so they do nothing until OPOS_SPAN above is on. In short: with OPOS_PANES unset the panes assets and tags are
# absent and page() is unchanged; the Network, first-run and time zone pages carry the Jaryo conformance fixes either way.
# OPOS_PANES=1,pure is the strict #000/#fff pair; OPOS_PANES=invert swaps the colours for the left hand without mirroring the layout.
Environment=OPOS_PANES=1
# <<< track panes
# >>> track firstboot: first-run setup, time zone page and the saved time zone (src/opos/firstrun.py); unset = none of it
Environment=OPOS_FIRSTRUN=1
# <<< track firstboot
# >>> track monitor: the Inference page (src/opos/monitor.py, monitor_web.py): GET /monitor and /api/monitor; unset = neither answers
# The optional file sets OPOS_AGIW_URL and OPOS_AGIW_HOST (see /etc/opos/monitor.env.example). Without OPOS_AGIW_URL
# nothing is fetched except the phone's own 127.0.0.1 model-port check.
Environment=OPOS_MONITOR=1
EnvironmentFile=-/etc/opos/monitor.env
# <<< track monitor
ExecStart=/usr/bin/python3 -m opos.web --port 8765 --live-battery
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
