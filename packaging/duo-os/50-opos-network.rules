// Duo OS image: the four NetworkManager actions the Network page uses.
// YES only for opos-server.service running as user droidian. An ssh login is not that unit.
// Polkit that does not set subject.system_unit is not granted.
// These actions also let that service connect or disconnect any NetworkManager connection
// and add, change or delete system connections, including mobile data and VPNs.
// Whether a running phone grants them is NOT_RUN.
polkit.addRule(function(action, subject) {
    var ids = [
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.scan"
    ];
    if (ids.indexOf(action.id) < 0) {
        return;
    }
    if (subject.user == "droidian" && subject.system_unit == "opos-server.service") {
        return polkit.Result.YES;
    }
});
