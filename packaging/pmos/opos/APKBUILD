# TODO(publish): publish the measured release-tarball and verify sha512 retrieval before remote builds.
maintainer="Old Phone OS <173626247+louiscalata@users.noreply.github.com>"
pkgname=opos
pkgver=0.1.0
pkgrel=3
pkgdesc="Old Phone OS Interface policy and optional helper"
url="https://github.com/louiscalata/old-phone-os"
arch="noarch"
license="GPL-3.0-or-later"
depends="python3 modemmanager polkit dbus"
makedepends="python3"
options="!check"
install="$pkgname.pre-install"
subpackages="$pkgname-systemd:_systemd $pkgname-openrc:_openrc"
_source_archive="opos-runtime-source-20261102.tar.gz"
_source_root="old-phone-os-source"
source="$_source_archive::https://github.com/louiscalata/old-phone-os/releases/download/v0.1.0-source-20261102/$_source_archive opos-sysusers.conf opos-kiosk opos-server.initd opos-firstboot.sh opos-kiosk-off.sh opos-firstboot.initd opos-server.service opos-firstboot.service opos-systemd-state.py"
builddir="$srcdir/$_source_root"
package() {
	install -Dm644 "$builddir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$builddir/THIRD_PARTY.md" "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
	mkdir -p "$pkgdir/usr/bin"
	printf '#!/bin/sh\nexec python3 -m opos.setup "$@"\n' > "$pkgdir/usr/bin/opos"
	chmod 755 "$pkgdir/usr/bin/opos"
	install -Dm644 "$srcdir/opos-sysusers.conf" "$pkgdir/usr/lib/sysusers.d/opos.conf"
	_sp=$(python3 -c "import sysconfig; print(sysconfig.get_path('purelib'))")
	mkdir -p "$pkgdir$_sp"
	cp -r "$builddir/src/opos" "$pkgdir$_sp"
	find "$pkgdir$_sp/opos" -name __pycache__ -exec rm -rf {} +
	install -Dm755 "$srcdir/opos-kiosk" "$pkgdir/usr/bin/opos-kiosk"
	install -Dm755 "$srcdir/opos-server.initd" "$pkgdir/etc/init.d/opos-server"
	install -Dm755 "$srcdir/opos-firstboot.sh" "$pkgdir/usr/bin/opos-firstboot"
	install -Dm755 "$srcdir/opos-kiosk-off.sh" "$pkgdir/usr/bin/opos-kiosk-off"
	install -Dm755 "$srcdir/opos-firstboot.initd" "$pkgdir/etc/init.d/opos-firstboot"
	install -Dm755 "$srcdir/opos-systemd-state.py" "$pkgdir/usr/libexec/opos-systemd-state"
}

_systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	install="$subpkgname.post-install"
	depends="systemd $pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"
	install -Dm644 "$srcdir/opos-server.service" "$subpkgdir/usr/lib/systemd/system/opos-server.service"
	install -Dm644 "$srcdir/opos-firstboot.service" "$subpkgdir/usr/lib/systemd/system/opos-firstboot.service"
}
_openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="openrc $pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"
}
