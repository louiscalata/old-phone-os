# Reference: https://postmarketos.org/uipkg
maintainer="Old Phone OS <173626247+louiscalata@users.noreply.github.com>"
pkgname="postmarketos-ui-opos"
pkgver=1
pkgrel=2
pkgdesc="(Wayland) Old Phone OS Interface kiosk prototype"
url="https://github.com/louiscalata/old-phone-os"
arch="noarch"
license="GPL-3.0-or-later"
depends="postmarketos-base-ui-cage opos chromium psmisc"
_pmb_groups="seat"
_pmb_recommends=""
install="$pkgname.post-install"
source="opos-cage.sh opos-tinydm-env.sh"
options="!check pmb:drm pmb:default-openrc pmb:support-openrc pmb:support-systemd"
subpackages="$pkgname-openrc:_openrc"
package() {
	install -Dm755 "$srcdir/opos-cage.sh" "$pkgdir/etc/cage-ui/opos.sh"
	# tinydm sources this before exec'ing cage; it is the only hook that reaches the compositor.
	install -Dm755 "$srcdir/opos-tinydm-env.sh" "$pkgdir/usr/share/tinydm/env-wayland.d/50-opos-renderer.sh"
}
_openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="networkmanager-openrc openrc"
	mkdir -p "$subpkgdir"
}
