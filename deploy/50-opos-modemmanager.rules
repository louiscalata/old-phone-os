polkit.addRule(function(action, subject) {
    if (subject.user == "opos") {
        if (action.id == "org.freedesktop.ModemManager1.Messaging" || action.id == "org.freedesktop.ModemManager1.Voice") {
            return polkit.Result.YES;
        }
    }
});
